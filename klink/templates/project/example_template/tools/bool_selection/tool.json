{
  "id": "bool_selection",
  "title": "Boolean on selection",
  "label": "BOOL",
  "description": "Merge, intersect, subtract or xor the selected shapes into one result.",
  "inputs": {"selection": {"min_shapes": 2}},
  "params": {
    "op":     {"type": "enum", "choices": ["or", "and", "not", "xor"], "default": "or", "title": "operation"},
    "target": {"type": "layer", "from": "layout", "allow_new": true, "allow_same": true, "default": "same",
               "title": "target layer"},
    "keep":   {"type": "bool", "default": false, "title": "keep source shapes"}
  },
  "presets": {
    "union":     {"title": "Union",        "params": {"op": "or"}},
    "intersect": {"title": "Intersection", "params": {"op": "and"}},
    "subtract":  {"title": "Subtract (first minus rest)", "params": {"op": "not"}},
    "xor":       {"title": "XOR",          "params": {"op": "xor"}}
  },
  "prompt": "missing"
}
